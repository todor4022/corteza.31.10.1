# Local deployment: https://docs.cortezaproject.org/corteza-docs/2026.9/devops-guide/index.html
VERSION=2026.9
HTTP_PORT=18080
DOMAIN=localhost:${HTTP_PORT}

# Database credentials are applied by PostgreSQL on its first start only.
# Use URL-safe passwords (for example: openssl rand -hex 24).
POSTGRES_DB=corteza
POSTGRES_USER=corteza
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DB_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable

# Serve the web applications and API from the same container.
HTTP_WEBAPP_ENABLED=true
HTTP_ENABLE_HEALTHCHECK_ROUTE=true
HTTP_ENABLE_VERSION_ROUTE=true
ACTIONLOG_ENABLED=true
CORREDOR_ENABLED=false

# Generate a separate secret with: openssl rand -hex 32
AUTH_JWT_SECRET=replace-with-a-random-signing-secret

# Local demo administrator, created automatically if this email is absent.
# Changing these values does not update an existing account.
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=DemoPassword123!

# Optional outgoing email. Without SMTP, local sign-ups are auto-confirmed.
# SMTP_HOST=smtp.example.com:587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Corteza <corteza@example.com>"
